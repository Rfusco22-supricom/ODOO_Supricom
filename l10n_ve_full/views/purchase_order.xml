<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="extra_purchase_order_venezuela" model="ir.ui.view">
            <field name="name">Extra purchase.order Venezuela</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                     <xpath expr="//field[@name='partner_id']"  position="attributes">
                         <attribute name="required">1</attribute>
                    </xpath>
                    <xpath expr="//field[@name='partner_id']" position="replace">
                             <field name="partner_id" widget="res_partner_many2one"  options='{"always_reload": True}'/>
                    </xpath>

                    <xpath expr="//field[@name='partner_ref']" position="before">
                            <field name="is_ve_company" invisible="1"/>
                            <field name="people_type_company" invisible="1"/>
                            <field name="people_type_individual" invisible="1"/>
                            <field name="company_type" invisible="1"/>
                     </xpath>
                     <xpath expr="//field[@name='partner_id']" position="after">
                         <field name="rif" string="RIF"
                                   readonly="state == 'draft'" invisible="company_type == 'person' or people_type_company == 'pjnd' or not is_ve_company"/>
                            <field name="nationality" string="Tipo de Documento"  readonly="state == 'draft'" invisible="company_type == 'company' or not is_ve_company"/>
                            <field name="identification_id" string="Documento de Identidad" readonly="state == 'draft'" invisible="company_type == 'company' or not is_ve_company"/>
                     </xpath>
                    <xpath expr="//field[@name='rif']" position="replace">
                            <field name="rif" string="RIF"
                                   invisible="company_type == 'person' or people_type_company == 'pjnd' or not is_ve_company"/>
                    </xpath>
            </field>
        </record>
    </data>
</odoo>

