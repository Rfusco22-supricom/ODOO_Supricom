<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recreate_picking_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.recreate.picking.wizard.form</field>
        <field name="model">sale.order.recreate.picking.wizard</field>
        <field name="arch" type="xml">
            <form string="Recrear Despacho">
                <div class="alert alert-warning text-center" role="alert" style="margin-top: 10px; margin-bottom: 20px;">
                    <strong>¡Atención!</strong><br/>
                    El despacho previamente generado se encuentra cancelado o fue eliminado.<br/>
                    ¿Desea volver a evaluar las reglas de stock y generar nuevamente el despacho?
                </div>
                <footer>
                    <button name="action_recreate" type="object" string="Sí, Generar Despacho" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action that the RedirectWarning will call -->
    <record id="action_recreate_picking_wizard" model="ir.actions.act_window">
        <field name="name">Regenerar Despacho</field>
        <field name="res_model">sale.order.recreate.picking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
