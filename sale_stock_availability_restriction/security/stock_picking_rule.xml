<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Global rule: hide pickings marked as despacho_oculto from all inventory views -->
        <!-- Regla desactivada: se reemplaza por override de _search en stock.picking
             para evitar bloquear lecturas internas (pronóstico, reportes, etc.) -->
        <record id="rule_stock_picking_despacho_oculto" model="ir.rule">
            <field name="name">Ocultar pickings sin autorización de despacho</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('despacho_oculto', '=', False)]</field>
            <field name="groups" eval="False"/>
            <field name="active" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
