<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_stock_availability" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.availability</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_check_credit_approval"
                        string="Consultar Estado / Recalcular Aprobación"
                        type="object"
                        class="btn-secondary"
                        icon="fa-refresh"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="autorizar_despacho"/>
                <label for="requiere_aprobacion"/>
                <div class="d-flex align-items-center">
                    <field name="requiere_aprobacion" readonly="1" force_save="1" class="oe_inline"/>
                    <button name="action_check_credit_approval"
                            type="object"
                            icon="fa-refresh"
                            title="Consultar estado de cuenta y recalcular aprobación"
                            class="btn btn-link p-0 ms-2"/>
                </div>
                <field name="excepcion_aprobada"/>
            </xpath>
            <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                <attribute name="invisible">not autorizar_despacho</attribute>
            </xpath>
        </field>
    </record>
</odoo>
