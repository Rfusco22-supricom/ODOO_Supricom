<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_view_company_price" model="ir.ui.view">
        <field name="name">product.pricelist.form.company.price</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field name="is_default_company_price"/>
            </xpath>
        </field>
    </record>
</odoo>
