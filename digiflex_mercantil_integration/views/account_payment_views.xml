<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- EXTENSIÓN FORMULARIO DE PAGO INDEPENDIENTE -->
    <record id="view_account_payment_form_inherit_bank_integration" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.bank.integration</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="bank_integration_enabled" invisible="1"/>
                <button name="action_open_bank_select_wizard" type="object" string="Consultar Banco" class="btn-info" icon="fa-university" invisible="state != 'draft' or not bank_integration_enabled"/>
            </header>
            <field name="ref" position="after">
                <field name="bank_transaction_line_id" readonly="1" invisible="not bank_transaction_line_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <!-- EXTENSIÓN WIZARD REGISTRO DE PAGO DE FACTURA (MODAL REGISTER PAYMENT) -->
    <record id="view_account_payment_register_form_inherit_bank_integration" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.bank.integration</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="communication" position="after">
                <field name="bank_integration_enabled" invisible="1"/>
                <field name="bank_transaction_line_id" readonly="1" invisible="not bank_transaction_line_id" options="{'no_create': True}"/>
            </field>
            <xpath expr="//footer" position="inside">
                <button name="action_open_bank_select_wizard" type="object" string="Consultar Banco" class="btn-info me-1" icon="fa-university" invisible="not bank_integration_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
