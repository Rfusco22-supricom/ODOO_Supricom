<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="category_bank_integration" model="ir.module.category">
            <field name="name">Integraciones Bancarias</field>
            <field name="description">Gestión de cuentas de integración y transacciones bancarias API</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_bank_integration_user" model="res.groups">
            <field name="name">Usuario de Integración Bancaria</field>
            <field name="category_id" ref="category_bank_integration"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_bank_integration_manager" model="res.groups">
            <field name="name">Administrador de Integración Bancaria</field>
            <field name="category_id" ref="category_bank_integration"/>
            <field name="implied_ids" eval="[(4, ref('group_bank_integration_user')), (4, ref('account.group_account_manager'))]"/>
        </record>

        <!-- Heredar automáticamente permisos en los grupos estándar de Contabilidad -->
        <record id="account.group_account_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_bank_integration_user'))]"/>
        </record>

        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_bank_integration_manager'))]"/>
        </record>
    </data>
</odoo>
