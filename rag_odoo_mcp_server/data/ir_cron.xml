<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Periodic garbage collection of OAuth tokens and authorization codes.
        See models/oauth.py — _gc() deletes revoked/expired tokens and used/expired codes.

        Note: MCP SSE sessions/messages are stored in raw SQL tables (mcp_session /
        mcp_message) and cleaned opportunistically in controllers/mcp_controller.py
        (_create_session), so they need no ORM-model cron here.
    -->
    <record id="ir_cron_mcp_oauth_gc" model="ir.cron">
        <field name="name">RAG Odoo MCP Server: GC OAuth tokens and codes</field>
        <field name="model_id" ref="model_rag_odoo_mcp_server_oauth_token"/>
        <field name="state">code</field>
        <field name="code">model._gc()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
