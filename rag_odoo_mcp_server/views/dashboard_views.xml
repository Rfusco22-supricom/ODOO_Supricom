<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Search view
             ============================================================ -->
        <record id="view_rag_mcp_dashboard_search" model="ir.ui.view">
            <field name="name">rag.mcp.dashboard.search</field>
            <field name="model">rag.mcp.dashboard</field>
            <field name="arch" type="xml">
                <search string="Claude Dashboards">
                    <field name="name"/>
                    <field name="user_id"/>
                    <filter name="filter_mine" string="My dashboards"
                            domain="[('user_id', '=', uid)]"/>
                    <filter name="filter_shared" string="Shared"
                            domain="[('is_shared', '=', True)]"/>
                    <filter name="filter_claude" string="Built by Claude"
                            domain="[('created_by_claude', '=', True)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_owner" string="Owner"
                                context="{'group_by': 'user_id'}"/>
                        <filter name="group_shared" string="Shared"
                                context="{'group_by': 'is_shared'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================
             List view
             ============================================================ -->
        <record id="view_rag_mcp_dashboard_list" model="ir.ui.view">
            <field name="name">rag.mcp.dashboard.list</field>
            <field name="model">rag.mcp.dashboard</field>
            <field name="arch" type="xml">
                <tree string="Claude Dashboards">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="widget_count"/>
                    <field name="is_shared"/>
                    <field name="created_by_claude"/>
                    <button name="action_open" type="object"
                            string="Open" icon="fa-external-link"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================
             Kanban view
             ============================================================ -->
        <record id="view_rag_mcp_dashboard_kanban" model="ir.ui.view">
            <field name="name">rag.mcp.dashboard.kanban</field>
            <field name="model">rag.mcp.dashboard</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard rag_mcp_dashboard_kanban"
                        default_order="sequence,id">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="user_id"/>
                    <field name="widget_count"/>
                    <field name="is_shared"/>
                    <field name="created_by_claude"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click rag_mcp_dashboard_card">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="description"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge text-bg-info me-1">
                                            <i class="fa fa-th"/>
                                            <field name="widget_count"/> widgets
                                        </span>
                                        <span t-if="record.is_shared.raw_value"
                                              class="badge text-bg-success me-1">
                                            Shared
                                        </span>
                                        <span t-if="record.created_by_claude.raw_value"
                                              class="badge text-bg-secondary">
                                            By Claude
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)"
                                             t-att-title="record.user_id.value"
                                             class="oe_kanban_avatar"
                                             alt="Owner"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================
             Form view: dashboard
             ============================================================ -->
        <record id="view_rag_mcp_dashboard_form" model="ir.ui.view">
            <field name="name">rag.mcp.dashboard.form</field>
            <field name="model">rag.mcp.dashboard</field>
            <field name="arch" type="xml">
                <form string="Claude Dashboard">
                    <header>
                        <button name="action_open" type="object"
                                string="Open Dashboard" class="btn-primary"
                                icon="fa-tachometer"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Dashboard name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="is_shared"/>
                                <field name="created_by_claude" readonly="1"/>
                                <field name="widget_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" placeholder="Short description..."/>
                        <notebook>
                            <page string="Widgets" name="widgets">
                                <field name="widget_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="title"/>
                                        <field name="widget_type"/>
                                        <field name="model_name"/>
                                        <field name="measure_aggregator"/>
                                        <field name="measure_field"/>
                                        <field name="group_by"/>
                                        <field name="col_x" string="X"/>
                                        <field name="col_y" string="Y"/>
                                        <field name="col_w" string="W"/>
                                        <field name="col_h" string="H"/>
                                    </tree>
                                    <form string="Widget">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="title"/>
                                                    <field name="widget_type"/>
                                                    <field name="model_name"/>
                                                    <field name="record_limit"/>
                                                </group>
                                                <group>
                                                    <field name="measure_aggregator"/>
                                                    <field name="measure_field"/>
                                                    <field name="group_by"/>
                                                    <field name="list_fields"/>
                                                </group>
                                            </group>
                                            <group string="Layout (12-col grid)">
                                                <group>
                                                    <field name="col_x"/>
                                                    <field name="col_y"/>
                                                </group>
                                                <group>
                                                    <field name="col_w"/>
                                                    <field name="col_h"/>
                                                </group>
                                            </group>
                                            <group string="Advanced">
                                                <field name="domain"
                                                       placeholder="[]"/>
                                                <field name="options_json"
                                                       placeholder="{}"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             Action + menus
             ============================================================ -->
        <record id="action_rag_mcp_dashboard" model="ir.actions.act_window">
            <field name="name">Claude Dashboards</field>
            <field name="res_model">rag.mcp.dashboard</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_rag_mcp_dashboard_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No dashboards yet
                </p>
                <p>
                    Ask Claude to build one for you, or create one manually
                    and add widgets pointing at any Odoo model.
                </p>
            </field>
        </record>

        <menuitem id="menu_rag_mcp_dashboard_root"
                  name="Claude Dashboards"
                  web_icon="rag_odoo_mcp_server,static/description/icon.png"
                  sequence="80"/>

        <menuitem id="menu_rag_mcp_dashboard_list"
                  name="Dashboards"
                  parent="menu_rag_mcp_dashboard_root"
                  action="action_rag_mcp_dashboard"
                  sequence="10"/>

    </data>
</odoo>
