<odoo>
    <data>
        <record id="action_report_invoice_custom_dual" model="ir.actions.report">
            <field name="name">Factura Fiscal Dual</field>
            <field name="model">account.move</field>
            <field name="report_name">forma_libre.report_invoice_template_dual</field>
            <field name="report_type">qweb-pdf</field>
            <!-- Llamar al método get_report_name() -->
            <field name="print_report_name">object.get_report_name()</field>
            <field name="paperformat_id" ref="forma_libre.fiscal_format"/>
            <field name="groups_id" eval="[(4, ref('l10n_ve_full.group_localizacion'))]"/>
        </record>
    </data>
</odoo>
