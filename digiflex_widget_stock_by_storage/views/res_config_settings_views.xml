<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_storage_location" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.storage.location</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='warehouse_setting_container']" position="inside">
                    <setting id="storage_location_setting" string="Ubicación de Stock por Defecto" help="Seleccione la ubicación de inventario que se utilizará para calcular y mostrar la cantidad a la mano en el botón inteligente de producto.">
                        <field name="storage_location_id"/>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
