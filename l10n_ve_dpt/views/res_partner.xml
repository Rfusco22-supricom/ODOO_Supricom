<?xml version="1.0"?>
<odoo>
    <data>
        <record id="res_partner_view_municipality_parish" model="ir.ui.view">
            <field name="name">res.partner.view.municipality_parish</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@class='o_address_format']" position="replace">
                    <div class="o_address_format">
                        <field name="street" placeholder="Calle..." class="o_address_street"
                               readonly="type == 'contact' and parent_id"/>
                        <field name="street2" placeholder="Calle 2..." class="o_address_street"
                               readonly="type == 'contact' and parent_id"/>
                        <div name="partner_address_country" class="d-flex justify-content-between">
                            <field name="country_id" placeholder="País" class="o_address_country" options='{"no_open": True, "no_create": True}'
                                readonly="type == 'contact' and parent_id"/>
                        </div>
                        <field name="state_id" class="o_address_state" placeholder="Estado" options="{'no_open': True, 'no_quick_create': True}"
                            readonly="type == 'contact' and parent_id" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                        <field name="city" placeholder="Ciudad" class="o_address_city"
                            readonly="type == 'contact' and parent_id"/>
                        <field name="municipality_id" placeholder="Municipio" options='{"no_open": True}' domain="[('state_id','=',state_id)]"/>
                        <field name="parish_id" placeholder="Parroquia" options='{"no_open": True}' domain="[('municipality_id','=',municipality_id)]"/>
                        <field name="zip" placeholder="C.P" class="o_address_zip"
                            readonly="type == 'contact' and parent_id"/>
                        <!-- campo sector -->
                        <field name='sector_id' domain="[('in_active','=',True)]" placeholder="Sector" />
                        <!--  -->

                    </div>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
