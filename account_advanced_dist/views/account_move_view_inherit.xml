<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_advanced_dist" model="ir.ui.view">
        <field name="name">account.move.form.inherit.advanced.dist</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_payment_split_wizard" 
                        string="Asignación Parcial" 
                        type="object" 
                        groups="account.group_account_invoice"
                        invisible="state != 'posted' or payment_state in ('paid', 'reversed')"/>
                <!-- <button name="action_open_apply_diff_wizard"
                        string="Aplicar Diferencial Cambiario"
                        type="object"
                        groups="account.group_account_invoice"
                        invisible="state != 'posted'"/> -->
            </xpath>
            
            <!-- Widget de Diferenciales Cambiarios - Mismo estilo que créditos/débitos pendientes -->
            <xpath expr="//field[@name='invoice_outstanding_credits_debits_widget']" position="after">
                <div invisible="exchange_differential_count == 0" class="mt-2">
                    <field name="exchange_differential_count" invisible="1"/>
                    <span class="text-muted small fw-bold">Diferenciales Cambiarios</span>
                    <field name="exchange_differential_widget" nolabel="1" class="w-100" widget="html"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_account_payment_split_server" model="ir.actions.server">
        <field name="name">Asignación Avanzada de Pagos</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_payment_split_wizard()
        </field>
    </record>
</odoo>