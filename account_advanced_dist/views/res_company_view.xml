<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_intercompany" model="ir.ui.view">
        <field name="name">res.company.form.intercompany</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inter-Company">
                    <group>
                        <group string="Cuentas para Inter-Company">
                            <field name="intercompany_receivable_account_id"/>
                            <field name="intercompany_payable_account_id"/>
                        </group>
                        <group string="Diario para Inter-Company o Pagos de Terceros">
                            <field name="intercompany_payment_journal_id"/>
                            <field name="exchange_diff_transit_account_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
