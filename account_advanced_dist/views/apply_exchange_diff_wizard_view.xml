<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_apply_exchange_diff_wizard_form" model="ir.ui.view">
        <field name="name">account.apply.exchange.diff.wizard.form</field>
        <field name="model">account.apply.exchange.diff.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar Diferencial Cambiario">
                <group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id"/>
                        <field name="transit_account_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="diff_type" widget="radio"/>
                        <field name="invoice_id" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Este asistente generará un asiento contable para ajustar el saldo en moneda local de la factura, utilizando la cuenta de tránsito configurada.
                </div>
                <footer>
                    <button string="Aplicar" name="action_apply_diff" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_apply_exchange_diff" model="ir.actions.act_window">
        <field name="name">Aplicar Diferencial Cambiario</field>
        <field name="res_model">account.apply.exchange.diff.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
