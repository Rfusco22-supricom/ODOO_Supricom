<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="category_count_inventory" model="ir.module.category">
            <field name="name">Conteo de Inventario</field>
            <field name="description">Gestión y ejecución de conteos cuantitativos de inventario</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_count_inventory_user" model="res.groups">
            <field name="name">Usuario Operador</field>
            <field name="category_id" ref="category_count_inventory"/>
            <field name="comment">Permite registrar cantidades contadas y usar la app OWL de conteos.</field>
        </record>

        <record id="group_count_inventory_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="category_count_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_count_inventory_user'))]"/>
            <field name="comment">Acceso total: crear sesiones, habilitar/deshabilitar conteo a ciegas, realizar cierres y generar ajustes en Odoo.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Regla Multi-Company para Conteo de Inventario -->
        <record id="digiflex_count_inventory_comp_rule" model="ir.rule">
            <field name="name">Conteo Inventario Multi-Company</field>
            <field name="model_id" ref="model_digiflex_count_inventory"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
