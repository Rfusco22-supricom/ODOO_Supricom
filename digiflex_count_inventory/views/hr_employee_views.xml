<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_count_inventory" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.count.inventory</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']//group[1]" position="inside">
                <group string="Conteo de Inventario">
                    <field name="count_inventory_available"/>
                    <field name="count_pin" password="true"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
