<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_count_inventory" model="report.paperformat">
        <field name="name">Conteo Inventario Full Page Paperformat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_count_inventory" model="ir.actions.report">
        <field name="name">Reporte de Conteo de Inventario</field>
        <field name="model">digiflex.count.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">digiflex_count_inventory.report_count_inventory</field>
        <field name="report_file">digiflex_count_inventory.report_count_inventory</field>
        <field name="print_report_name">'Conteo_Inventario_%s' % (object.name.replace('/', '_'))</field>
        <field name="binding_model_id" ref="model_digiflex_count_inventory"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_count_inventory"/>
    </record>
</odoo>
