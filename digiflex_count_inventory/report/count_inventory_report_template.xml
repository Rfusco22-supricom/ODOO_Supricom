<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_count_inventory">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="digiflex_count_inventory.report_count_inventory_document"/>
            </t>
        </t>
    </template>

    <template id="report_count_inventory_document">
        <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #1e293b; padding: 0px 5px !important; margin: 0px !important;">
            <!-- ENCABEZADO PERSONALIZADO (LOGO + EMPRESA + TÍTULO) -->
            <div class="row align-items-center mb-3 pb-3 border-bottom" style="border-bottom: 2px solid #0284c7 !important;">
                <div class="col-3">
                    <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 70px; max-width: 180px;" alt="Logo"/>
                </div>
                <div class="col-5">
                    <h5 class="fw-bold mb-0 text-dark" t-field="doc.company_id.name"/>
                    <small class="text-muted d-block" style="font-size: 10px;">
                        <span t-field="doc.company_id.street"/> <span t-field="doc.company_id.city"/>
                    </small>
                    <small class="text-muted d-block" style="font-size: 10px;" t-if="doc.company_id.vat">
                        RIF: <span t-field="doc.company_id.vat"/>
                    </small>
                </div>
                <div class="col-4 text-end">
                    <h4 class="fw-bold text-primary mb-0" style="font-size: 16px;">CONTEO DE INVENTARIO</h4>
                    <span class="badge bg-primary fs-6 px-2 py-1 mt-1"><t t-esc="doc.name"/></span>
                </div>
            </div>

            <!-- METADATOS Y PARÁMETROS EN TARJETA -->
            <div class="row mb-4 p-3 bg-light rounded border" style="font-size: 11px; background-color: #f8fafc !important;">
                <div class="col-6">
                    <div class="mb-1"><strong>Ubicación de Almacén:</strong> <span t-field="doc.location_id.complete_name"/></div>
                    <div class="mb-1">
                        <strong>Tipo de Auditoría:</strong> 
                        <span t-if="doc.count_type == 'daily'">Cíclico Diario</span>
                        <span t-else="">Total de Productos</span>
                    </div>
                    <t t-if="doc.count_type == 'daily'">
                        <div class="mb-1"><strong>Fecha Ventas Auditadas:</strong> <span t-field="doc.sales_target_date"/></div>
                    </t>
                    <div><strong>Modo a Ciegas:</strong> <span t-esc="'Sí' if doc.hide_theoretical_qty else 'No'"/></div>
                </div>
                <div class="col-6 text-end">
                    <div class="mb-1"><strong>Fecha de Conteo:</strong> <span t-field="doc.date"/></div>
                    <div class="mb-1"><strong>Estado de Sesión:</strong> <span t-field="doc.state"/></div>
                    <div class="mb-1"><strong>Administrador:</strong> <span t-field="doc.user_id.name"/></div>
                    <t t-if="doc.employee_ids">
                        <div>
                            <strong>Operadores:</strong>
                            <t t-foreach="doc.employee_ids" t-as="emp">
                                <span class="badge bg-secondary me-1"><t t-esc="emp.name"/></span>
                            </t>
                        </div>
                    </t>
                </div>
            </div>

            <t t-set="diff_lines" t-value="doc.line_ids.filtered(lambda l: l.is_counted and l.difference_state in ['missing', 'surplus'])"/>
            <t t-set="normal_lines" t-value="doc.line_ids.filtered(lambda l: not l.is_counted or l.difference_state == 'match')"/>

            <!-- SECCIÓN 1: PRODUCTOS CON DIFERENCIA AUDITADA -->
            <div class="mb-4">
                <div class="p-2 bg-danger text-white rounded-top d-flex justify-content-between align-items-center mb-0" style="background-color: #dc2626 !important;">
                    <strong style="font-size: 11px;">1. PRODUCTOS CON DIFERENCIA AUDITADA</strong>
                    <span class="badge bg-white text-danger fw-bold" style="font-size: 10px;"><t t-esc="len(diff_lines)"/> Ítems</span>
                </div>

                <t t-if="diff_lines">
                    <table class="table table-sm table-bordered mb-0" style="font-size: 10px; border-top: none;">
                        <thead class="table-dark text-center" style="background-color: #1e293b !important; color: white;">
                            <tr>
                                <th style="width: 12%;">Código</th>
                                <th style="width: 32%;">Producto</th>
                                <th style="width: 8%;">UdM</th>
                                <th style="width: 16%;">Operador</th>
                                <th style="width: 8%;" t-if="not doc.hide_theoretical_qty">Teórica</th>
                                <th style="width: 8%;">Contada</th>
                                <th style="width: 8%;" t-if="not doc.hide_theoretical_qty">Diferencia</th>
                                <th style="width: 8%;" t-if="not doc.hide_theoretical_qty">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="diff_lines" t-as="line">
                                <tr t-att-style="line.difference_state == 'missing' and 'background-color: #fee2e2;' or 'background-color: #e0f2fe;'">
                                    <td><span t-field="line.product_id.default_code"/></td>
                                    <td><strong><span t-field="line.product_id.display_name"/></strong></td>
                                    <td class="text-center"><span t-field="line.product_uom_id.name"/></td>
                                    <td class="text-center"><span t-field="line.assigned_employee_id.name"/></td>
                                    <td class="text-end" t-if="not doc.hide_theoretical_qty"><span t-field="line.theoretical_qty"/></td>
                                    <td class="text-end fw-bold"><span t-field="line.counted_qty"/></td>
                                    <td class="text-end fw-bold" t-if="not doc.hide_theoretical_qty">
                                        <span t-field="line.difference_qty"/>
                                    </td>
                                    <td class="text-center fw-bold" t-if="not doc.hide_theoretical_qty">
                                        <span t-if="line.difference_state == 'missing'" class="text-danger">FALTANTE</span>
                                        <span t-elif="line.difference_state == 'surplus'" class="text-primary">SOBRANTE</span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <div class="p-2 border border-top-0 rounded-bottom text-center text-success bg-success-subtle small">
                        ✓ No se registraron diferencias de inventario en los productos contados.
                    </div>
                </t>
            </div>

            <!-- SECCIÓN 2: PRODUCTOS A CONTAR Y CONTEOS EXACTOS -->
            <div class="mb-4">
                <div class="p-2 bg-primary text-white rounded-top d-flex justify-content-between align-items-center mb-0" style="background-color: #0284c7 !important;">
                    <strong style="font-size: 11px;">2. PRODUCTOS A CONTAR Y CONTEOS EXACTOS</strong>
                    <span class="badge bg-white text-primary fw-bold" style="font-size: 10px;"><t t-esc="len(normal_lines)"/> Ítems</span>
                </div>

                <table class="table table-sm table-bordered mb-0" style="font-size: 10px; border-top: none;">
                    <thead class="table-light text-center" style="background-color: #f1f5f9 !important;">
                        <tr>
                            <th style="width: 12%;">Código</th>
                            <th style="width: 36%;">Producto</th>
                            <th style="width: 8%;">UdM</th>
                            <th style="width: 18%;">Operador Asignado</th>
                            <th style="width: 8%;" t-if="not doc.hide_theoretical_qty">Teórica</th>
                            <th style="width: 9%;">Contada</th>
                            <th style="width: 9%;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="normal_lines" t-as="line">
                            <tr>
                                <td><span t-field="line.product_id.default_code"/></td>
                                <td><span t-field="line.product_id.display_name"/></td>
                                <td class="text-center"><span t-field="line.product_uom_id.name"/></td>
                                <td class="text-center"><span t-field="line.assigned_employee_id.name"/></td>
                                <td class="text-end" t-if="not doc.hide_theoretical_qty"><span t-field="line.theoretical_qty"/></td>
                                <td class="text-end fw-bold"><span t-field="line.counted_qty"/></td>
                                <td class="text-center">
                                    <span t-if="not line.is_counted" class="badge bg-secondary">Pendiente</span>
                                    <span t-elif="line.difference_state == 'match'" class="badge bg-success">Exacto</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- RESUMEN FINAL -->
            <div class="row mt-3 pt-2 border-top" style="font-size: 11px;">
                <div class="col-6">
                    <strong>Total Ítems Auditados / Contados:</strong> <t t-esc="doc.total_items"/>
                </div>
                <div class="col-6 text-end" t-if="not doc.hide_theoretical_qty">
                    <strong>Total Ítems con Diferencia:</strong> <t t-esc="len(diff_lines)"/>
                </div>
            </div>

            <!-- FIRMAS -->
            <div class="row text-center" style="font-size: 10px; margin-top: 50px !important;">
                <div class="col-6">
                    ____________________________________<br/>
                    <strong>Firma Responsable Conteo</strong>
                </div>
                <div class="col-6">
                    ____________________________________<br/>
                    <strong>Firma Administrador / Almacén</strong>
                </div>
            </div>
        </div>
    </template>
</odoo>
