<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vista que agrega el banner -->
        <record id="neutralize_banner" model="ir.ui.view">
            <field name="name">Neutralize Banner</field>
            <field name="inherit_id" ref="web.layout"/>
            <field name="arch" type="xml">
                <xpath expr="//body" position="inside">
                    <t t-if="request.env and request.env.company and 'homologacion_activa' in request.env.company and request.env.company.sudo().homologacion_activa">
                        <div id="banner_fiscal_block"
                             style="background-color:#222; color:white; text-align:center; padding:10px; font-weight: bold;">
                            🔧 VERSIÓN: 17.0.1<br/>
                        </div>
                    </t>
                </xpath>
            </field>
        </record>
    </data>
</odoo>