<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_currency_exchange" model="ir.module.category">
        <field name="name">Compra/Transferencia de Divisas</field>
        <field name="description">Gestiona acceso a las operaciones de compra y transferencia de divisas.</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_currency_exchange_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_currency_exchange"/>
    </record>

    <record id="group_currency_exchange_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_currency_exchange"/>
        <field name="implied_ids" eval="[(4, ref('group_currency_exchange_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
