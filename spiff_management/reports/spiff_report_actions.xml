<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte original (combinado) -->
    <record id="action_report_spiff_calculation" model="ir.actions.report">
        <field name="name">Reporte de SPIFF</field>
        <field name="model">spiff.calculation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">spiff_management.report_spiff_calculation</field>
        <field name="report_file">spiff_management.report_spiff_calculation</field>
        <field name="print_report_name">'Cálculo SPIFF - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_spiff_calculation"/>
        <field name="binding_type">report</field>
    </record>

