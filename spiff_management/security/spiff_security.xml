<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule for Spiff Incentive -->
        <record id="spiff_incentive_comp_rule" model="ir.rule">
            <field name="name">Spiff Rules Multi-Company</field>
            <field name="model_id" ref="model_spiff_incentive"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Record Rule for Spiff Calculation -->
        <record id="spiff_calculation_comp_rule" model="ir.rule">
            <field name="name">Spiff Calculations Multi-Company</field>
            <field name="model_id" ref="model_spiff_calculation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
