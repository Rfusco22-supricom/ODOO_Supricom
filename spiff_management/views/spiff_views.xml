<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spiff_incentive_tree" model="ir.ui.view">
        <field name="name">spiff.incentive.tree</field>
        <field name="model">spiff.incentive</field>
        <field name="arch" type="xml">
            <tree string="Reglas SPIFF">
                <field name="name"/>
                <field name="rule_type"/>
                <field name="product_id" optional="show"/>
                <field name="brand_id" optional="hide"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_spiff_incentive_form" model="ir.ui.view">
        <field name="name">spiff.incentive.form</field>
        <field name="model">spiff.incentive</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Bono Octubre Canon"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="rule_type" widget="radio"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuración">
                            <group invisible="rule_type != 'product'">
                                <field name="product_id"/>
                                <field name="incentive_per_unit"/>
                            </group>
                            <group invisible="rule_type != 'brand'">
                                <field name="brand_id"/>
                                <field name="target_amount"/>
                                <field name="incentive_amount"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                     <field name="message_follower_ids"/>
                     <field name="activity_ids"/>
                     <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_spiff_calculation_form" model="ir.ui.view">
        <field name="name">spiff.calculation.form</field>
        <field name="model">spiff.calculation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculate" string="Calcular SPIFFs" type="object" class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_calculate" string="Recalcular" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- Smart Button: Ver Detalle -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_detail" type="object"
                                class="oe_stat_button" icon="fa-list-ul"
                                invisible="state == 'draft'">
                            <span class="o_stat_text">Ver Detalle</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="calculation_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resultados">
                            <field name="line_ids">
                                <tree editable="bottom" create="0">
                                    <field name="user_id"/>
                                    <field name="rule_id"/>
                                    <field name="total_quantity" sum="Total Cant." optional="show"/>
                                    <field name="total_amount_sold" sum="Total Vendido" optional="show"/>
                                    <field name="spiff_amount" sum="Total a Pagar" decoration-success="spiff_amount > 0" decoration-bf="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- VISTA ÁRBOL: Detalle SPIFF por línea factura  -->
    <!-- ============================================= -->
    <record id="view_spiff_line_detail_tree" model="ir.ui.view">
        <field name="name">spiff.calculation.line.detail.tree</field>
        <field name="model">spiff.calculation.line.detail</field>
        <field name="arch" type="xml">
            <tree string="Detalle SPIFF" create="0" edit="0">
                <field name="user_id" string="Vendedor" optional="show"/>
                <field name="rule_id" string="Regla"/>
                <field name="invoice_date" string="Fecha"/>
                <field name="invoice_id" string="Factura" optional="show"/>
                <field name="partner_id" string="Cliente"/>
                <field name="product_id" string="Producto"/>
                <field name="quantity" string="Cantidad" sum="Total Cant."/>
                <field name="amount_sold" string="Monto Vendido" sum="Total Monto"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- VISTA BÚSQUEDA: filtros y agrupaciones -->
    <record id="view_spiff_line_detail_search" model="ir.ui.view">
        <field name="name">spiff.calculation.line.detail.search</field>
        <field name="model">spiff.calculation.line.detail</field>
        <field name="arch" type="xml">
            <search string="Buscar Detalle SPIFF">
                <field name="user_id" string="Vendedor"/>
                <field name="rule_id" string="Regla"/>
                <field name="partner_id" string="Cliente"/>
                <field name="product_id" string="Producto"/>
                <field name="invoice_id" string="Factura"/>
                <separator/>
                <filter string="Por Regla" name="group_by_rule" context="{'group_by': 'rule_id'}"/>
                <filter string="Por Vendedor" name="group_by_user" context="{'group_by': 'user_id'}"/>
                <filter string="Por Cliente" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Por Mes" name="group_by_month" context="{'group_by': 'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ACCIÓN del detalle (standalone) -->
    <record id="action_spiff_line_detail" model="ir.actions.act_window">
        <field name="name">Detalle SPIFF</field>
        <field name="res_model">spiff.calculation.line.detail</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_spiff_line_detail_search"/>
        <field name="context">{'search_default_group_by_rule': 1}</field>
    </record>


    <record id="action_spiff_incentive" model="ir.actions.act_window">
        <field name="name">Reglas SPIFF</field>
        <field name="res_model">spiff.incentive</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_spiff_calculation" model="ir.actions.act_window">
        <field name="name">Cálculos SPIFF</field>
        <field name="res_model">spiff.calculation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_spiff_brand_tree" model="ir.ui.view">
        <field name="name">spiff.brand.tree</field>
        <field name="model">spiff.brand</field>
        <field name="arch" type="xml">
            <tree string="Marcas SPIFF" editable="bottom">
                <field name="name"/>
                <field name="credit_extension_days"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_spiff_brand" model="ir.actions.act_window">
        <field name="name">Marcas SPIFF</field>
        <field name="res_model">spiff.brand</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_spiff_root" name="Comisiones &amp; SPIFF" parent="sale.sale_menu_root" sequence="50"/>
    <menuitem id="menu_spiff_brand" name="Marcas SPIFF" parent="menu_spiff_root" action="action_spiff_brand" sequence="1"/>
    <menuitem id="menu_spiff_rules" name="Reglas SPIFF" parent="menu_spiff_root" action="action_spiff_incentive" sequence="2"/>
    <menuitem id="menu_spiff_reports" name="Cálculos / Reportes" parent="menu_spiff_root" action="action_spiff_calculation" sequence="3"/>

    <record id="view_product_template_form_spiff" model="ir.ui.view">
        <field name="name">product.template.form.spiff</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="spiff_brand_id"/>
            </xpath>
        </field>
    </record>
</odoo>