        <!-- 
            Reglas de Registro para Usuario SENIAT
            Estas reglas restringen las operaciones de escritura, creación y eliminación
            para el grupo SENIAT, permitiendo solo lectura
        -->

        
        <!-- Contabilidad - Configuración -->
        <record id="account.menu_finance_configuration" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('account.group_account_manager')])]"/>
        </record>

