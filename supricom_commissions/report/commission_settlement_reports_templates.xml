<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- TEMPLATE: DETAIL REPORT -->
    <template id="report_settlement_detail">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-8">
                                <h2>Liquidación de Comisiones</h2>
                                <h4><span t-field="o.name"/></h4>
                            </div>
                            <div class="col-4 text-right">
                                <strong>Estado:</strong> <span t-field="o.state"/>
                            </div>
                        </div>

                        <div class="row mt32 mb32" style="border: 1px solid #ddd; padding: 15px; border-radius: 5px;">
                            <div class="col-6">
                                <strong>Vendedor:</strong> <span t-field="o.salesperson_id.name"/><br/>
                                <strong>País:</strong> <span t-esc="o.salesperson_id.vendor_type_id.country"/><br/>
                                <strong>Tipo:</strong> <span t-field="o.salesperson_id.vendor_type_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Periodo:</strong> <span t-field="o.date_from"/> - <span t-field="o.date_to"/><br/>
                                <strong>Meta Mensual:</strong> <span t-field="o.target_amount"/>
                                <t t-if="o.is_ve_company">
                                    / <span t-field="o.target_amount_ref"/>
                                </t>
                            </div>
                        </div>
                        
                        <!-- KPIs -->
                        <div class="row mb32 text-center">
                            <div class="col">
                                <div class="card p-2 bg-light">
                                    <strong>Total Cobrado</strong>
                                    <h4 class="text-primary">
                                        <span t-field="o.total_collected"/>
                                        <div t-if="o.is_ve_company" style="font-size: 0.7em; color: #666;">
                                            <span t-field="o.total_collected_ref"/>
                                        </div>
                                    </h4>
                                </div>
                            </div>
                            <div class="col">
                                <div class="card p-2 bg-light">
                                    <strong>Total Facturado</strong>
                                    <h4 class="text-primary">
                                        <span t-field="o.total_invoiced"/>
                                        <div t-if="o.is_ve_company" style="font-size: 0.7em; color: #666;">
                                            <span t-field="o.total_invoiced_ref"/>
                                        </div>
                                    </h4>
                                </div>
                            </div>
                            <div class="col">
                                <div class="card p-2 bg-light">
                                    <strong>% Cumplimiento</strong>
                                    <h4 class="text-info">
                                        <span t-esc="o.achievement_pct * 100" t-options='{"widget": "float", "precision": 2}'/>%
                                    </h4>
                                </div>
                            </div>
                             <div class="col">
                                <div class="card p-2 bg-light">
                                    <strong>% Penalización</strong>
                                    <h4 class="text-danger">
                                        <span t-field="o.min_price_penalty_pct"/>%
                                    </h4>
                                </div>
                            </div>
                            <div class="col">
                                <div class="card p-2 bg-light">
                                    <strong>Total a Pagar</strong>
                                    <h3 class="text-success">
                                        <span t-field="o.total_commission"/>
                                        <div t-if="o.is_ve_company" style="font-size: 0.6em; color: #666;">
                                            <span t-field="o.total_commission_ref"/>
                                        </div>
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <!-- DETAILED TABLE -->
                        <h4>Detalle de Cálculo</h4>
                        <table class="table table-sm table-striped table-bordered mt16" style="font-size: 11px;">
                            <thead class="thead-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Cliente</th>
                                    <th>Factura</th>
                                    <th>Producto</th>
                                    <th>Término Pago</th>
                                    <th class="text-center">Días Créd.</th>
                                    <th class="text-center">Días Pago</th>
                                    <th class="text-center">Días Mora</th>
                                    <th class="text-center">Factor Mora %</th>
                                    <th class="text-right">Precio/Base</th>
                                    <th class="text-right">Costo</th>
                                    <th class="text-center">% Com</th>
                                    <th class="text-center">% Ded</th>
                                    <th class="text-right">Monto Com.</th>
                                    <th t-if="o.is_ve_company" class="text-right">Com. ($)</th>
                                    <th>Observación</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.date"/></td>
                                    <td><span t-field="line.client_id.name"/></td>
                                    <td><span t-field="line.invoice_id.name"/></td>
                                    <td><span t-field="line.product_id.name"/></td>
                                    <!-- PAYMENT TERM (From Invoice) -->
                                    <td><span t-field="line.invoice_id.invoice_payment_term_id.name"/></td>
                                    <td class="text-center"><span t-field="line.days_credit"/></td>
                                    <td class="text-center"><span t-field="line.days_paid"/></td>
                                    <td class="text-center"><span t-field="line.days_overdue"/></td>
                                    <td class="text-center"><span t-esc="line.mora_penalty_factor * 100" t-options='{"widget": "float", "precision": 0}'/>%</td>
                                    
                                    <td class="text-right"><span t-field="line.amount_paid"/></td>
                                    <td class="text-right"><span t-field="line.cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    
                                    <td class="text-center">
                                        <span t-esc="line.commission_pct" t-options='{"widget": "float", "precision": 2}'/>%
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="line.deduction_pct" t-options='{"widget": "float", "precision": 2}'/>%
                                        <t t-if="line.penalty_pct > 0"><br/><small class="text-danger">(-<span t-esc="line.penalty_pct"/>% Pen)</small></t>
                                    </td>
                                    
                                    <td class="text-right font-weight-bold">
                                        <span t-field="line.commission_amount"/>
                                    </td>
                                    <td t-if="o.is_ve_company" class="text-right">
                                        <span t-field="line.commission_amount_usd"/>
                                    </td>
                                    <td>
                                        <t t-if="line.is_excluded"><small class="text-muted"><span t-field="line.exclude_reason"/></small></t>
                                        <t t-elif="line.days_overdue > 0"><small class="text-warning"><span t-esc="line.days_overdue"/>d de mora</small></t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <div class="row mt32">
                            <div class="col-6 text-center">
                                __________________________<br/>
                                Firma del Vendedor<br/>
                                <small><span t-field="o.salesperson_id.name"/></small>
                            </div>
                            <div class="col-6 text-center">
                                __________________________<br/>
                                Aprobado por Gerencia
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- TEMPLATE: SUMMARY/CONSOLIDATED REPORT -->
    <template id="report_settlement_summary">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Reporte Consolidado de Comisiones</h2>
                    <h5 class="text-center mb32">Periodo: <span t-esc="docs and docs[0].date_from"/> - <span t-esc="docs and docs[0].date_to"/></h5>

                    <!-- KPI Total General a Pagar (Centrado) -->
                    <t t-set="grand_total_kpi" t-value="sum(o.total_commission for o in docs)"/>
                    <t t-set="grand_total_ref_kpi" t-value="sum(o.total_commission_ref for o in docs) if (docs and docs[0].is_ve_company) else 0.0"/>
                    
                    <div class="row mb32" style="text-align: center;">
                        <div class="card p-2 bg-light" style="width: 340px; margin: 0 auto; float: none; border: 1px solid #ddd; border-radius: 5px;">
                            <strong>Total General a Pagar</strong>
                            <h3 class="text-success mb-0">
                                <span t-esc="grand_total_kpi" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id or user.company_id.currency_id}'/>
                                <div t-if="docs and docs[0].is_ve_company" style="font-size: 0.6em; color: #666;">
                                    <span t-esc="grand_total_ref_kpi" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id_ref}'/>
                                </div>
                            </h3>
                        </div>
                    </div>

                    <table class="table table-striped table-bordered mt32">
                        <thead class="thead-dark">
                            <tr>
                                <th>Periodo</th>
                                <th>Vendedor</th>
                                <th>Tipo</th>
                                <th class="text-right">Meta</th>
                                <th class="text-right">Cobrado</th>
                                <th class="text-right">Facturado</th>
                                <th class="text-center">% Cumplimiento</th>
                                <th class="text-right">Total Comisión</th>
                                <th t-if="docs and docs[0].is_ve_company" class="text-right">
                                    Comisión (<span t-esc="docs[0].currency_id_ref.symbol or docs[0].currency_id_ref.name"/>)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="grand_total" t-value="0"/>
                            <t t-set="grand_total_ref" t-value="0"/>
                            <tr t-foreach="docs" t-as="o">
                                <td><span t-field="o.date_from"/> / <span t-field="o.date_to"/></td>
                                <td><span t-field="o.salesperson_id.name"/></td>
                                <td><span t-field="o.salesperson_id.vendor_type_id.name"/></td>
                                <td class="text-right"><span t-field="o.target_amount"/></td>
                                <td class="text-right"><span t-field="o.total_collected"/></td>
                                <td class="text-right"><span t-field="o.total_invoiced"/></td>
                                <td class="text-center">
                                    <span t-esc="o.achievement_pct * 100" t-options='{"widget": "float", "precision": 2}'/>%
                                </td>
                                <td class="text-right font-weight-bold">
                                    <span t-field="o.total_commission"/>
                                    <t t-set="grand_total" t-value="grand_total + o.total_commission"/>
                                </td>
                                <td t-if="o.is_ve_company" class="text-right">
                                    <span t-esc="o.total_commission_ref" t-options='{"widget": "monetary", "display_currency": o.currency_id_ref}'/>
                                    <t t-set="grand_total_ref" t-value="grand_total_ref + o.total_commission_ref"/>
                                </td>
                            </tr>
                            <tr class="bg-light font-weight-bold">
                                <td colspan="7" class="text-right">TOTAL GENERAL:</td>
                                <td class="text-right"><span t-esc="grand_total" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id or user.company_id.currency_id}'/></td>
                                <td t-if="docs and docs[0].is_ve_company" class="text-right">
                                    <span t-esc="grand_total_ref" t-options='{"widget": "monetary", "display_currency": docs[0].currency_id_ref}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Firmas de Aprobación Consolidada -->
                    <div class="row mt64">
                        <div class="col-6 text-center">
                            __________________________<br/>
                            Firma del Colaborador / Vendedor
                        </div>
                        <div class="col-6 text-center">
                            __________________________<br/>
                            Aprobado por Gerencia
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
