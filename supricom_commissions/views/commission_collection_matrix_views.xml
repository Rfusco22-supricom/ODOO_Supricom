<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_commission_collection_matrix_form" model="ir.ui.view">
        <field name="name">commission.collection.matrix.form</field>
        <field name="model">commission.collection.matrix</field>
        <field name="arch" type="xml">
            <form string="Regla de Matriz de Cobranza (Morosidad)">
                <sheet>
                    <group>
                        <group string="Ámbito de Aplicación">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="user_id" placeholder="Vacío = Regla General (Empresa)"/>
                            <field name="payment_type"/>
                        </group>
                        <group string="Escala de Días y % de Comisión">
                            <field name="days_from"/>
                            <field name="days_to"/>
                            <field name="commission_factor_pct"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" placeholder="Observaciones sobre esta regla de mora..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_commission_collection_matrix_tree" model="ir.ui.view">
        <field name="name">commission.collection.matrix.tree</field>
        <field name="model">commission.collection.matrix</field>
        <field name="arch" type="xml">
            <tree string="Matriz de Cobranza (Morosidad)" editable="bottom">
                <field name="company_id" options="{'no_create': True}"/>
                <field name="user_id"/>
                <field name="payment_type"/>
                <field name="days_from"/>
                <field name="days_to"/>
                <field name="commission_factor_pct"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_commission_collection_matrix" model="ir.actions.act_window">
        <field name="name">Matriz de Cobranza (Morosidad)</field>
        <field name="res_model">commission.collection.matrix</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una regla de morosidad para la Matriz de Cobranza.
            </p>
            <p>
                Define los tramos de días de retraso tras la fecha de vencimiento y el porcentaje de comisión a reconocer (ej. 100%, 50%, 30%, 0%).
            </p>
        </field>
    </record>
</odoo>
