<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_commission" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_header']" position="after">
                <group name="commission_authorization" string="Autorización de Precios" groups="sales_team.group_sale_manager">
                    <field name="allow_below_min_price" string="Permitir por debajo del Precio Mínimo"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
