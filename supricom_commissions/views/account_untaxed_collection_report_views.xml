<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_account_untaxed_collection_report_tree" model="ir.ui.view">
        <field name="name">account.untaxed.collection.report.tree</field>
        <field name="model">account.untaxed.collection.report</field>
        <field name="arch" type="xml">
            <tree string="Cobros por Vendedor (Base Imponible)" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="salesperson_id" widget="many2one_avatar_user"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="payment_id"/>
                <field name="amount_gross" sum="Total Bruto ($)"/>
                <field name="amount_untaxed" sum="Total Base Imponible ($)"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_account_untaxed_collection_report_pivot" model="ir.ui.view">
        <field name="name">account.untaxed.collection.report.pivot</field>
        <field name="model">account.untaxed.collection.report</field>
        <field name="arch" type="xml">
            <pivot string="Cobros por Vendedor (Base Imponible)" disable_linking="true">
                <field name="salesperson_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_untaxed" type="measure"/>
                <field name="amount_gross" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_account_untaxed_collection_report_graph" model="ir.ui.view">
        <field name="name">account.untaxed.collection.report.graph</field>
        <field name="model">account.untaxed.collection.report</field>
        <field name="arch" type="xml">
            <graph string="Cobros por Vendedor (Base Imponible)" type="bar" sample="1">
                <field name="salesperson_id"/>
                <field name="amount_untaxed" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_account_untaxed_collection_report_search" model="ir.ui.view">
        <field name="name">account.untaxed.collection.report.search</field>
        <field name="model">account.untaxed.collection.report</field>
        <field name="arch" type="xml">
            <search string="Buscar Cobros">
                <field name="salesperson_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="payment_id"/>
                <filter string="Vendedor" name="filter_salesperson" domain="[]" context="{'group_by':'salesperson_id'}"/>
                <filter string="Cliente" name="filter_partner" domain="[]" context="{'group_by':'partner_id'}"/>
                <filter string="Mes de Cobro" name="filter_month" domain="[]" context="{'group_by':'date:month'}"/>
                <filter string="Compañía" name="filter_company" domain="[]" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_account_untaxed_collection_report" model="ir.actions.act_window">
        <field name="name">Cobros por Vendedor (Base Imponible)</field>
        <field name="res_model">account.untaxed.collection.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="context">{'search_default_filter_salesperson': 1, 'search_default_filter_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay cobros registrados en la base imponible.
            </p>
            <p>
                Este reporte analiza el dinero efectivamente cobrado por cada vendedor según la base imponible (subtotal sin IVA) de las facturas reconciliadas.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <!-- Under Accounting > Receivables (Clientes / Cobros) -->
    <menuitem id="menu_account_untaxed_collection_report"
              name="Cobros por Vendedor (Base Imponible)"
              parent="account.menu_finance_receivables"
              action="action_account_untaxed_collection_report"
              sequence="25"/>

    <!-- Under Comisiones > Reportes -->
    <menuitem id="menu_commission_untaxed_collection_report"
              name="Cobros por Vendedor (Base Imponible)"
              parent="menu_commission_root"
              action="action_account_untaxed_collection_report"
              sequence="50"/>
</odoo>
