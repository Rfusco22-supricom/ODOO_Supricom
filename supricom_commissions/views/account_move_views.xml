<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_supricom_commissions" model="ir.ui.view">
        <field name="name">account.move.form.inherit.supricom.commissions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="manual_commission_override" string="Forzar Comisión Manual" groups="supricom_commissions.group_commission_manager"/>
                <field name="manual_commission_note" string="Nota de Comisión Manual" groups="supricom_commissions.group_commission_manager" invisible="not manual_commission_override"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="after">
                <field name="product_cost" string="Costo del Producto" optional="hide"/>
                <field name="commission_base" string="Base de Comisión" optional="hide"/>
                <field name="commission_amount" string="Monto de Comisión" optional="hide"/>
                <field name="deduction_percentage" string="% de Deducción" optional="hide"/>
                <field name="commission_final_amount" string="Comisión Final" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
