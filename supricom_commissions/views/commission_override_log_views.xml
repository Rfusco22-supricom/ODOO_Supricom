<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_override_log_tree" model="ir.ui.view">
        <field name="name">commission.override.log.tree</field>
        <field name="model">commission.override.log</field>
        <field name="arch" type="xml">
            <tree string="Log de Excepción de Comisiones" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="user_id"/>
                <field name="move_id"/>
                <field name="payment_id"/>
                <field name="salesperson_id"/>
                <field name="amount_paid"/>
                <field name="commission_amount" optional="hide"/>
                <field name="note"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="action_commission_override_log" model="ir.actions.act_window">
        <field name="name">Log de Excepción</field>
        <field name="res_model">commission.override.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_commission_override_log"
              name="Log de Excepción"
              parent="supricom_commissions.menu_commission_root"
              action="action_commission_override_log"
              sequence="50"/>

</odoo>
