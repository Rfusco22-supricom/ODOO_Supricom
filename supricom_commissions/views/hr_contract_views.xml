<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_inherit_supricom_commissions" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.supricom.commissions</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="after">
                <group string="Comisiones" name="group_commissions">
                    <field name="commission_vendor_type_id" string="Tipo de Vendedor"/>
                    <field name="fix_commission_rate" string="Tasa de Comisión Fija" widget="percentage"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
