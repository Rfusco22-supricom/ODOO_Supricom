<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="multicert_felgt_res_users_view_form" model="ir.ui.view">
            <field name="name">multicert_felgt_res_users_view_form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='preferences']" position="after">
                    <page string="FEL" name="fel">
                        <group string="Documento por Defecto Usuario">
                            <field name="fel_gt_invoice_default_type"/>
                        </group>
                    </page>
                </xpath>
            </field>
    </record>

</odoo>