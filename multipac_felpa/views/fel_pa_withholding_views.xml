<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Withholding Certificate Form View -->
    <record id="fel_pa_withholding_form_view" model="ir.ui.view">
        <field name="name">fel_pa.withholding.form</field>
        <field name="model">fel_pa.withholding</field>
        <field name="arch" type="xml">
            <form decoration-muted="state == 'cancelled'">
                <field name="state" invisible="1"/>
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" string="Imprimir Certificado" type="object" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state != 'confirmed'" confirm="¿Está seguro de cancelar este certificado?"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="resolution_text" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Retención">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="move_id"/>
                                    <field name="invoice_date"/>
                                    <field name="base_imponible"/>
                                    <field name="itbms_causado"/>
                                    <field name="itbms_retenido"/>
                                    <field name="total_a_pagar"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_base"/>
                                <field name="total_itbms_causado"/>
                                <field name="total_itbms_retenido"/>
                                <field name="total_a_pagar" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Withholding Certificate Tree View -->
    <record id="fel_pa_withholding_tree_view" model="ir.ui.view">
        <field name="name">fel_pa.withholding.tree</field>
        <field name="model">fel_pa.withholding</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="total_base"/>
                <field name="total_itbms_causado"/>
                <field name="total_itbms_retenido"/>
                <field name="total_a_pagar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Withholding Certificate Search View -->
    <record id="fel_pa_withholding_search_view" model="ir.ui.view">
        <field name="name">fel_pa.withholding.search</field>
        <field name="model">fel_pa.withholding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmado" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelado" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Contribuyente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Withholding Certificate Action -->
    <record id="action_fel_pa_withholding" model="ir.actions.act_window">
        <field name="name">Certificados de Retención</field>
        <field name="res_model">fel_pa.withholding</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un Certificado de Retención ITBMS
            </p>
        </field>
    </record>

</odoo>
