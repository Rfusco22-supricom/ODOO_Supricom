<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    
    <record id="multipac_felpa_res_partner_form_view_inherit" model="ir.ui.view">
        <field name="name">multipac.felpa.res.partner.form.inherit</field>
        <field name="active">True</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">99</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
			<xpath expr="//span[@name='address_name']" position="before">
				<field name="is_panama_company" invisible="1"/>
				<field name="fel_pa_fe_active" widget="boolean_toggle" invisible="not is_panama_company"/>
			</xpath>
			<xpath expr="//field[@name='vat']" position="after">
				<field name="fel_pa_dv" placeholder="DV" class="oe_inline" invisible="not is_panama_company or not fel_pa_fe_active"/>
			</xpath>
			<xpath expr="//field[@name='category_id']" position="after">
				<field name="fel_pa_recipient_type" invisible="not is_panama_company or not fel_pa_fe_active"/>
				<field name="fel_pa_taxpayer_type" invisible="not is_panama_company or not fel_pa_fe_active"/>			
			</xpath>
			<xpath expr="//form//sheet" position="before">
				<header>
					<button name="validate_ruc" string="Validar RUC" type="object" invisible="not is_panama_company or not fel_pa_fe_active"/>
				</header>
			</xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
				<page string="Configuración Panamá FEL" invisible="not is_panama_company or not fel_pa_fe_active">
					<group string="Configuración Predeterminada">
						<group>
							<field name="fel_pa_recipient_type"/>
							<field name="fel_pa_taxpayer_type"/>
							<field name="fel_pa_dv"/>
							<field name="fel_pa_company_name"/>
							<field name="fel_pa_affiliated_fe"/>
							<field name="fel_pa_ignore_verificartion"/>
							<button name="validate_ruc" type="object" string="Validar RUC" colspan="2" invisible="not id"/>
						</group>
					</group>
				</page>
			</xpath>
        </field>
    </record>

	<record id="fel_pa_partner_address_form" model="ir.ui.view">
		<field name="name">multipac_felpa.res.partner.address.form</field>
		<field name="model">res.partner</field>
		<field name="priority" eval="900"/>
		<field name="arch" type="xml">
			<form>
				<div class="o_address_format">
					<field name="country_enforce_cities" invisible="1"/>
					<field name="parent_id" invisible="1"/>
					<field name="type" invisible="1"/>
					<field name="fel_pa_fe_active" invisible="1"/>
					<field name="is_panama_company" invisible="1"/>
					<field name="street" placeholder="Calle..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
					<field name="street2" placeholder="Calle 2..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
					<field name="city" invisible="1" placeholder="Ciudad" class="o_address_city" readonly="type == 'contact' and parent_id"/>
					<field name="fel_pa_county_id" domain="[('city_id', '=?', city_id)]" options="{'no_open': True, 'no_create': True}" placeholder="Corregimiento..." invisible="not is_panama_company or not fel_pa_fe_active"/>
					<field name="city_id" domain="[('state_id', '=?', state_id)]" options="{'no_open': True, 'no_create': True}" placeholder="Distrito..."/>
					<field name="state_id" class="o_address_state" placeholder="Provincia..." options="{'no_open': True, 'no_quick_create': True}"  context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
					<field name="country_id" placeholder="País" class="o_address_country" options="{'no_open': True, 'no_create': True}" readonly="type == 'contact' and parent_id"/>
					<field name="zip" placeholder="Código Postal" class="o_address_zip" readonly="type == 'contact' and parent_id"/>
				</div>
			</form>
		</field>
	</record>

</odoo>
