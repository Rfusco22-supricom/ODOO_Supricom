<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Invoice Template -->
        <record id="report_invoice_template_contemporary" model="ir.actions.report">
            <field name="name">Vintage</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">multipac_felpa.report_invoice_template_custom</field>
            <field name="report_file">multipac_felpa.report_invoice_template_custom</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">None</field>
        </record>
