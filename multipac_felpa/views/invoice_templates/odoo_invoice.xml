<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_template_custom_odoo">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <t t-set="theme_color" t-value="o.company_id and o.company_id.fel_pa_theme_color"/>
            <t t-set="theme_text_color" t-value="o.company_id and o.company_id.fel_pa_theme_text_color"/>
            <t t-set="company_color" t-value="o.company_id and o.company_id.fel_pa_company_color"/>
            <t t-set="company_address_color" t-value="o.company_id and o.company_id.fel_pa_company_address_color"/>
            <t t-set="customer_color" t-value="o.company_id and o.company_id.fel_pa_customer_color"/>
            <t t-set="customer_address_color" t-value="o.company_id and o.company_id.fel_pa_customer_address_color"/>
            <t t-set="text_color" t-value="o.company_id and o.company_id.fel_pa_text_color"/>
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
            <div class="row" t-att-style="'font-family:'+(o.company_id.fel_pa_font_id.family or '')+';font-size:'+str(o.company_id.fel_pa_font_size)+'px;'">
                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <div class="col-6">
                        <t t-set="information_block">
                            <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                <strong>Dirección de Entrega:</strong>
                                <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            </div>
                        </t>
                    </div>
                    <div class="col-6" name="address_not_same_as_shipping">
                        <t t-set="address">
                            <t t-call="multipac_felpa.invoice_templates_customer_details"/>
                        </t>
                    </div>
                </t>
                <t t-elif="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
                    <div class="offset-col-6 col-6" name="address_same_as_shipping">
                        <t t-set="address">
                            <t t-call="multipac_felpa.invoice_templates_customer_details"/>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="offset-col-6 col-6" name="no_shipping">
                        <t t-set="address">
                            <t t-call="multipac_felpa.invoice_templates_customer_details"/>
                        </t>
                    </div>
                </t>
            </div>
            <div class="mt-5 clearfix" t-att-style="'font-family:'+(o.company_id.fel_pa_font_id.family or '')+';font-size:'+str(o.company_id.fel_pa_font_size)+'px;'">
                <div class="page mb-4">
                    
                    <t t-if="o.fel_pa_cufe">
                        <h2>
                            <t t-if="o.fel_pa_cufe">
                                <strong>Comprobante Auxiliar de Factura Electrónica</strong><br/>
                            </t>
                        </h2>
                        <h4>
                            <span t-esc="o._fel_pa_invoice_name()"/>
                        </h4>
                    </t>
                    <t t-else="">
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Factura en Borrador</span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura Cancelada</span>
                        <span t-if="o.move_type == 'out_refund'">Nota de Credito</span>
                        <span t-if="o.move_type == 'in_refund'">Nota de Credito Proveedor</span>
                        <span t-if="o.move_type == 'in_invoice'">Factura Proveedor</span>
                    </t>
                    <div class="oe_structure"></div>
                    <div id="informations" class="row mt-3 mb-1">
                        <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.fel_pa_document_number" name="dte_number">
                            <strong>Número:</strong><br/>
                            <span t-if="o.fel_pa_document_number" t-field="o.fel_pa_document_number">INV/2023/0001</span>
                        </div>
                        <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.fel_pa_document_code" name="serie">
                            <strong>Sucursal/Punto:</strong><br/>
                            <span t-if="o.fel_pa_document_code" t-field="o.fel_pa_document_code">INV/2023/0001</span>
                        </div>
                        <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_date" name="invoice_date">
                            <strong>Fecha:</strong><br/>
                            <span t-field="o.invoice_date">2023-09-12</span>
                        </div>
                        <t t-if="o.invoice_date_due and o.company_id.fel_pa_invoice_show_invoice_date_due">
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                                <strong>Fecha Vencimiento:</strong><br/>
                                <span t-field="o.invoice_date_due">2023-10-31</span>
                            </div>
                        </t>
                        <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.delivery_date" name="delivery_date">
                            <strong>Fecha Entrega:</strong><br/>
                            <span t-field="o.delivery_date">2023-09-25</span>
                        </div>
                        <t t-if="o.invoice_origin and o.company_id.fel_pa_invoice_show_origin_order_name">
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_origin" name="origin">
                                <strong>Origen:</strong><br/>
                                <span t-field="o.invoice_origin">SO123</span>
                            </div>
                        </t>
                        <t t-if="o.company_id.fel_pa_invoice_show_invoice_ref">
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.ref" name="reference">
                                <strong>Referencia:</strong><br/>
                                <span t-field="o.ref">INV/2023/00001</span>
                            </div>
                        </t>
                        <t t-if="o.partner_id.ref and o.company_id.fel_pa_invoice_show_customer_code">
                            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.partner_id.ref" name="customer_code">
                                <strong>Customer Code:</strong><br/>
                                <span t-field="o.partner_id.ref"/>
                            </div>
                        </t>
                    </div>

                    <div class="oe_structure"></div>

                    <div style="padding:5px 0px 0 0; font-weight:bold; width:100%;" >
                        <t t-call="multipac_felpa.report_invoice_order_lines"/>
                    </div>

                    <div>
                        <t t-call="multipac_felpa.invoice_subtotal_tem" />
                    </div>
                    <div t-attf-style="border-bottom:1px solid #{'#959595'}; padding:0px">
                        <t t-call="multipac_felpa.template_total_amount_word"/>
                    </div>
                    <div t-if="not o._compute_payments_widget_reconciled_info() and not o.company_id.fel_pa_invoice_hide_payment_status">
                        <p t-att-style="'font-weight:bold; color:#000; margin-bottom:0; text-transform:capitalize; margin-top:8px; color: %s;' % (text_color)">
                        Estado del Pago: 
                            <span t-esc="dict(o._fields['payment_state']._description_selection(o.env)).get(o.payment_state)"/>
                        </p>
                    </div>
                    <div class="pull-left" style="color: #{text_color or '#000000'}; padding-top:5px; ">
                        <t t-call="multipac_felpa.report_invoice_notes"/>
                    </div>
                    <div align="right"  style="color: #{text_color or '#000000'};">
                        <t t-call="multipac_felpa.report_invoice_signature"/>
                    </div>
                    <div class="oe_structure"/>
                    <t t-call="multipac_felpa.report_invoice_barcode"/>
                    <t t-call="multipac_felpa.report_invoice_fel_pac"/>

                    <t t-set="company" t-value="o.company_id"/>
                    <t t-call="multipac_felpa.template_footer"/>

                </div>
            </div>
        </t>
    </template>
    <template id="report_invoice_template_odoo_duplicate" inherit_id="multipac_felpa.report_invoice_template_custom_odoo" primary="True">

    </template>
</odoo>