<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="multipac_felpa_account_move_withholding_inherit" model="ir.ui.view">
        <field name="name">multipac_felpa_account_move_withholding_inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Colocar botón y campos de retención dentro del Other Info tab (other_tab) -->
            <xpath expr="//page[@id='other_tab']" position="inside">
                <field name="is_panama_company" invisible="1"/>
                <group string="Retenciones ITBMS" invisible="move_type != 'in_invoice' or not is_panama_company">
                    <group>
                        <field name="fel_pa_has_confirmed_withholding" invisible="1"/>
                        <button name="action_create_withholding" string="Crear Certificado de Retención" type="object" class="btn-primary" invisible="state != 'posted' or fel_pa_has_confirmed_withholding" colspan="2"/>
                    </group>
                    <field name="fel_pa_withholding_ids" readonly="1" nolabel="1" colspan="2">
                        <tree>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="total_base"/>
                            <field name="total_itbms_causado"/>
                            <field name="total_itbms_retenido"/>
                            <field name="total_a_pagar"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-success="state == 'confirmed'"
                                   decoration-danger="state == 'cancelled'"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
