<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regla Multicompañía para Reporte CxC -->
        <record id="digiflex_cxc_report_comp_rule" model="ir.rule">
            <field name="name">Digiflex CxC Report Multi-Company</field>
            <field name="model_id" ref="model_digiflex_cxc_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
