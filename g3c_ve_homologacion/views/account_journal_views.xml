<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_igtf" model="ir.ui.view">
        <field name="name">account.journal.form.igtf</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_igtf_debit_note" invisible="type != 'sale'"/>
                <field name="nro_ctrl_sequence_id" invisible="type not in ('sale', 'purchase')"/>
            </xpath>
        </field>
    </record>
</odoo>
