<odoo>
    <record id="view_payment_term_form_inherit_cash" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.cash</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_cash_payment" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
