<odoo>
    <record id="view_move_form_fiscal_restrictions" model="ir.ui.view">
        <field name="name">account.move.form.fiscal.restrictions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <!-- Campos de control al nivel del Formulario (Parent) -->
            <xpath expr="//form" position="inside">
                <field name="homologacion_activa" invisible="1"/>
                <field name="move_type" invisible="1"/>
                <field name="is_usd_invoice" invisible="1"/>
                <field name="is_cash_payment_term" invisible="1"/>
            </xpath>
            
            <!-- Colocar campos de pago de contado después de la Tasa -->
            <xpath expr="//field[@name='tax_today']" position="after">
                <field name="amount_pay_usd" invisible="not is_usd_invoice or not is_cash_payment_term" readonly="state == 'posted'" required="is_usd_invoice and is_cash_payment_term"/>
                <field name="partial_amount_bs" invisible="not is_usd_invoice or not is_cash_payment_term or amount_pay_usd == amount_total" readonly="1" force_save="1"/>
            </xpath>

            <!-- Número de Control: Readonly en Ventas (solo si homologación activa) -->
            <xpath expr="//field[@name='nro_ctrl']" position="attributes">
                <attribute name="readonly">(move_type in ('out_invoice', 'out_refund', 'out_receipt') and homologacion_activa) or state != 'draft'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Hacer readonly el Cliente cuando la factura está publicada (solo si homologación activa) -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state == 'posted' and homologacion_activa</attribute>
            </xpath>

            <!-- Hacer readonly los impuestos en las líneas de factura (solo si homologación activa) -->
            <!-- CRITICO: En las líneas debemos usar 'parent.campo' para acceder a campos del formulario -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="readonly">parent.homologacion_activa</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="readonly">parent.homologacion_activa</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Restringir productos a servicios solo si homologación activa -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">parent.homologacion_activa and parent.move_type in ['out_invoice', 'out_refund'] and [('type', '=', 'service')] or []</attribute>
            </xpath>

            <!-- Ocultar botón "Enviar e Imprimir" solo si homologación activa -->
            <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">homologacion_activa</attribute>
            </xpath>

            <!-- Ocultar botón "Vista previa" solo si homologación activa -->
            <xpath expr="//button[@name='preview_invoice']" position="attributes">
                <attribute name="invisible">homologacion_activa</attribute>
            </xpath>
        </field>
    </record>

    <!-- Ocultar botón "Editar tasa" en Facturas (solo si homologación activa) -->
    <record id="view_move_form_hide_edit_trm" model="ir.ui.view">
        <field name="name">account.move.form.hide.edit.trm</field>
        <field name="model" >account.move</field>
        <field name="inherit_id" ref="account_dual_currency.account_move_form_inherit_views"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="homologacion_activa" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='edit_trm']" position="attributes">
                <attribute name="invisible">homologacion_activa</attribute>
            </xpath>
        </field>
    </record>

    <!-- Controlar visibilidad de botones IGTF
         COMENTADO PORQUE EL USUARIO APAGÓ LA VISTA EN EL MANIFEST DE LOGICACERO
    <record id="view_move_form_hide_igtf_usd" model="ir.ui.view">
        <field name="name">account.move.form.hide.igtf.usd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="logicacero_igtf.view_move_form_inherit_igtf"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="homologacion_activa" invisible="1"/>
            </xpath>
            <xpath expr="(//button[@name='action_apply_igtf_tax'])[1]" position="attributes">
                <attribute name="invisible" add="not homologacion_activa" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='action_apply_igtf_tax'])[2]" position="attributes">
                <attribute name="invisible" add="not homologacion_activa" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='action_apply_igtf_tax'])[3]" position="attributes">
                <attribute name="invisible" add="not homologacion_activa" separator=" or "/>
            </xpath>
        </field>
    </record>
    -->

    <!-- Ocultar botones de impresión de Forma Libre -->
    <record id="view_invoice_form_cond_print_button" model="ir.ui.view">
        <field name="name">account.move.form.cond.print.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="forma_libre.view_invoice_form_with_print_button"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="homologacion_activa" invisible="1"/>
                <field name="is_usd_company" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_print_invoice_custom_dual'][1]" position="attributes">
                <attribute name="invisible" add="not homologacion_activa and not is_usd_company" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_print_invoice_custom_dual'][2]" position="attributes">
                <attribute name="invisible" add="not homologacion_activa and not is_usd_company" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_print_invoice_custom_dual'][3]" position="attributes">
                <attribute name="invisible" add="not homologacion_activa and not is_usd_company" separator=" or "/>
            </xpath>
        </field>
    </record>

    <!-- Ocultar sección "Información Fiscal" (Libro Fiscal) en empresas Homologadas.       -->
    <!-- Se hereda de l10n_ve_full para garantizar que el grupo ya existe al aplicar el XPath -->
    <record id="view_move_form_hide_fiscal_book_homologacion" model="ir.ui.view">
        <field name="name">account.move.form.hide.fiscal.book.homologacion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_ve_full.extra_account_move_venezuela"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//field[@name='sin_cred']/../.." position="attributes">
                <attribute name="invisible">not is_ve_company or homologacion_activa</attribute>
            </xpath>
        </field>
    </record>

</odoo>
