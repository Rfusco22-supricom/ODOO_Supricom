<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_homologacion" model="ir.ui.view">
        <field name="name">res.company.form.homologacion</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="G3C Config" name="g3c_config" groups="base.group_no_one">
                    <group>
                        <field name="is_ve_company"/>
                        <field name="homologacion_activa"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
