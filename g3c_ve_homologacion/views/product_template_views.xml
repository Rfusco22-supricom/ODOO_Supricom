<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Quitar el required del campo 'Impuestos del cliente' en la ficha de producto.
         El required de taxes_id lo maneja nuestro constraint Python según homologacion_activa.
         Aplicamos sobre la vista base de account para reemplazar los campos visuales. -->

    <record id="view_product_template_taxes_not_required_account" model="ir.ui.view">
        <field name="name">product.template.form.taxes.not.required.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <!-- Taxes (Ventas) -->
            <xpath expr="//field[@name='taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="active_company_taxes_id" string="Impuestos del cliente" widget="many2many_tags" context="{'default_company_id': allowed_company_ids[0]}" domain="[('company_id', 'in', allowed_company_ids)]"/>
            </xpath>
            
            <!-- Supplier Taxes (Compras) -->
            <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='supplier_taxes_id']" position="after">
                <field name="active_company_supplier_taxes_id" string="Impuestos del proveedor" widget="many2many_tags" context="{'default_company_id': allowed_company_ids[0]}" domain="[('company_id', 'in', allowed_company_ids)]"/>
            </xpath>
        </field>
    </record>
</odoo>
