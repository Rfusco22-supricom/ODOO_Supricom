<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Heredar los valid layouts estándar para inyectar el mensaje fiscal 
        solo en reportes de inventario (aquellos cuyo modelo contiene "stock")
        Condicionado a que la homologación esté activa en la compañía.
    -->

    <!-- Layout Standard -->
    <template id="external_layout_standard_fiscal_disclaimer" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="inside">
            <!-- Marca de agua para TODOS los estados de sale.order -->
            <t t-if="o and (o._name == 'sale.order') and o.company_id.homologacion_activa">
                <div class="watermark" style="position:absolute;opacity:0.05;font-size:8em;width:100%;text-align:center;z-index:9999;top:400px;transform:rotate(-45deg);pointer-events:none;">
                    NO FISCAL
                </div>
            </t>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="inside">
            <t t-if="o and (o._name == 'sale.order' or 'stock' in o._name) and o.company_id.homologacion_activa">
                <div class="text-center mb-2" style="font-weight: bold; font-size: 14px; margin-bottom: 5px;">
                    <t t-if="o._name == 'sale.order'">
                        <span t-if="o.state in ['draft', 'sent']">Presupuesto No Fiscal</span>
                        <span t-else="">Orden de Venta No Fiscal</span>
                        <br/>
                    </t>
                    Documento sin derecho a crédito fiscal
                </div>
                <div t-if="o._name == 'account.move'" class="text-center" style="font-size: 10px;">
                    Hora de emisión: <span t-esc="o.create_date.strftime('%H:%M:%S')"/>
                </div>
            </t>
        </xpath>
    </template>

