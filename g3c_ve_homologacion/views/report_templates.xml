    <!-- Guía de Despacho Title in Delivery Slip -->
    <template id="report_delivery_document_guia_despacho" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]/h2" position="before">
            <h2 class="mt0" t-if="o.company_id.homologacion_activa">Guía de Despacho</h2>
        </xpath>
    </template>

    <!-- Modificación del Reporte de Pedido (Sale Order) -->
    <template id="report_saleorder_document_no_fiscal_title" inherit_id="sale.report_saleorder_document">
        <!-- Cambiar Título Orden -> Pedido (solo si homologación activa) -->
        <xpath expr="//div[hasclass('page')]/h2" position="replace">
            <h2 class="mt-4">
                <t t-if="doc.company_id.homologacion_activa">
                    <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                    <span t-elif="doc.state in ['draft','sent']">Presupuesto # </span>
                    <span t-else="">Pedido # </span>
                </t>
                <t t-else="">
                    <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                    <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                    <span t-else="">Order # </span>
                </t>
                <span t-field="doc.name"/>
            </h2>
        </xpath>
        
        <!-- Ocultar Totales solo si NO es presupuesto (draft/sent) y homolgación activa -->
        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-att-style">"display: none !important;" if doc.company_id.homologacion_activa and doc.state not in ['draft', 'sent'] else ""</attribute>
        </xpath>
    </template>

</odoo>
