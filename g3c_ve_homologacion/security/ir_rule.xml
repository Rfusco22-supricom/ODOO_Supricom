<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Allow reading account.tax across all companies for internal users.
         Taxes are reference data needed by shared products (no company_id).
         Group-based rules are ORed with global rules, so this effectively
         allows reading any tax for any internal user. -->
    <record id="account_tax_cross_company_read_rule" model="ir.rule">
        <field name="name">account.tax: cross-company read for shared products</field>
        <field name="model_id" ref="account.model_account_tax"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
