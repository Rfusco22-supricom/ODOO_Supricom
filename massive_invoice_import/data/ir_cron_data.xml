<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_import_documentos_queue" model="ir.cron">
            <field name="name">Procesar Importación Masiva de Facturas</field>
            <field name="model_id" ref="model_import_documentos"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_imports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
