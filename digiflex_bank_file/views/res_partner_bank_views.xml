<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bank_tree_vzla" model="ir.ui.view">
        <field name="name">res.bank.tree.vzla</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_tree"/>
        <field name="arch" type="xml">
            <field name="country" position="after">
                <field name="bank_code_vzla"/>
            </field>
        </field>
    </record>

    <record id="view_bank_form_vzla" model="ir.ui.view">
        <field name="name">res.bank.form.vzla</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>

        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="bank_code_vzla"/>
            </field>
        </field>
    </record>
</odoo>
