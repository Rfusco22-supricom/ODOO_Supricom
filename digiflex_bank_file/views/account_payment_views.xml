<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_payment_tree_inherit_sent" model="ir.ui.view">
        <field name="name">account.payment.tree.sent_to_bank</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="amount_signed" position="before">
                <field name="sent_to_bank"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_sent" model="ir.ui.view">
        <field name="name">account.payment.form.sent_to_bank</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="partner_bank_id" position="after">
                <field name="sent_to_bank"/>
            </field>
        </field>
    </record>
</odoo>
