<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bank_file_wizard_form" model="ir.ui.view">
        <field name="name">bank.file.wizard.form</field>
        <field name="model">bank.file.wizard</field>
        <field name="arch" type="xml">
            <form string="Descargar Archivo Banco">
                <sheet>
                    <group>
                        <group colspan="4">
                            <field name="payment_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="journal_id" options="{'no_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="output_format" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Descargar" type="object" name="action_download_file" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- <record id="action_bank_file_wizard" model="ir.actions.act_window">
