<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_import_serials" model="ir.ui.view">
        <field name="name">account.move.form.import.serials</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_import_serials_wizard"
                        string="Importar Seriales (Excel)"
                        type="object"
                        class="btn-secondary"
                        invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
