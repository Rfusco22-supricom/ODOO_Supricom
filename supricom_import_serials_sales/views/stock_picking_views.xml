<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_import_serials" model="ir.ui.view">
        <field name="name">stock.picking.form.import.serials</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_import_serials_wizard"
                        string="Importar Seriales (Excel)"
                        type="object"
                        class="btn-secondary"
                        invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
