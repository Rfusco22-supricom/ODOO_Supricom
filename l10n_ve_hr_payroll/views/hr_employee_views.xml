<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_ve" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.ve</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group name="nomina_ve" string="Nómina">
                    <field name="benefits_balance"/>
                    <field name="bcv_interest_rate"/>
                    <field name="paid_vacation_days"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
