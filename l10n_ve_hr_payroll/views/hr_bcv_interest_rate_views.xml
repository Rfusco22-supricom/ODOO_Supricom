<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_bcv_interest_rate_tree" model="ir.ui.view">
        <field name="name">hr.bcv.interest.rate.tree</field>
        <field name="model">hr.bcv.interest.rate</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="company_id" column_invisible="True"/>
                <field name="year"/>
                <field name="month"/>
                <field name="rate"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_bcv_interest_rate_form" model="ir.ui.view">
        <field name="name">hr.bcv.interest.rate.form</field>
        <field name="model">hr.bcv.interest.rate</field>
        <field name="arch" type="xml">
            <form string="Tasa de Interés BCV">
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_bcv_interest_rate" model="ir.actions.act_window">
        <field name="name">Tasas de Interés BCV Mensual</field>
        <field name="res_model">hr.bcv.interest.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree el registro para la Tasa de Interés del BCV del mes actual.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_payroll_configuration_ve" name="Nómina" parent="hr.menu_human_resources_configuration" sequence="100"/>
    <menuitem id="menu_hr_bcv_interest_rate" name="Tasa Interés BCV Mensual" parent="menu_hr_payroll_configuration_ve" action="action_hr_bcv_interest_rate" sequence="10"/>
</odoo>
