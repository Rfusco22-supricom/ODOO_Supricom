<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bcv_connect" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bcv.connect</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="main_currency_setting_container" position="inside">
                <setting id="bcv_connect_setting" title="Seleccione las monedas que desea sincronizar automáticamente con las tasas del Banco Central de Venezuela." help="Configuración de BCV Connect">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="bcv_usd_currency_id" class="col-lg-5 o_light_label"/>
                            <field name="bcv_usd_currency_id" options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <div class="row mt16">
                            <label for="bcv_eur_currency_id" class="col-lg-5 o_light_label"/>
                            <field name="bcv_eur_currency_id" options="{'no_create': True, 'no_open': True}"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
