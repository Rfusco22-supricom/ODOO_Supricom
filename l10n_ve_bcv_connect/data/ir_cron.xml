<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_update_bcv_rates" model="ir.cron">
            <field name="name">Update BCV Rates</field>
            <field name="model_id" ref="model_l10n_ve_bcv_scraper"/>
            <field name="state">code</field>
            <field name="code">model.update_rates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
        </record>
    </data>
</odoo>
