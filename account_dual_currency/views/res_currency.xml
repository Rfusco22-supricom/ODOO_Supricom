<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_form_inherit_views_ve" model="ir.ui.view">
        <field name="name">view_currency_form_inherit_views_ve</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field invisible="1" name="facturas_por_actualizar"/>
                <div class="alert alert-danger" invisible="facturas_por_actualizar == True" role="alert" style="margin-bottom:0px;">
                    <strong>
                        - Existen facturas por actualizar a la nueva tasa
                    </strong>
                </div>
                <header>
                    <button class="oe_highlight" invisible="facturas_por_actualizar == True" name="actualizar_facturas" string="Actualizar Facturas" type="object"/>
                    <button class="oe_highlight" name="actualizar_productos" string="Actualizar Productos" type="object"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='currency_subunit_label']" position="after">
                <field name="sincronizar"/>
                <field invisible="sincronizar == False" name="server" required="sincronizar == True"/>
                <button class="oe_highlight" invisible="sincronizar == False" name="actualizar_tasa" string="Actualizar Ahora" type="object"/>
                <field invisible="1" name="facturas_por_actualizar"/>
            </xpath>
            <!--<xpath expr="//sheet" position="before">
                    <header>
                        <button name="actualizar_facturas" string="Actualizar Facturas" class="oe_highlight" type="object" />
                        <button name="actualizar_productos" string="Actualizar Productos" class="oe_highlight" type="object"/>
                    </header>
                    <div class="alert alert-danger" role="alert" style="margin-bottom:0px;"
                     invisible="facturas_por_actualizar == 0">
                        <strong>
                            - Existen facturas por actualizar a la nueva tasa
                        </strong>
                    </div>
                </xpath>-->
            <!--<xpath expr="//field[@name='currency_subunit_label']" position="after">
                     <field name="inverse_rate" />
                </xpath>--></field>
    </record>
    <record id="currency_tree_inherit_ve" model="ir.ui.view">
        <field name="name">currency.tree.inherit.increment.precision.ve</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rate']" position="before">
                <field name="inverse_rate"/>
            </xpath></field>
    </record>
</odoo>
