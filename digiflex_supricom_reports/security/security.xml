<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Security Rule for Sales Margin Report -->
        <record id="rule_digiflex_sales_margin_report_company" model="ir.rule">
            <field name="name">Reporte de Ventas y Margen - Multi-Company</field>
            <field name="model_id" ref="model_digiflex_sales_margin_report"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
