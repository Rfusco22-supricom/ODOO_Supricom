<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Header: Icono de Carrito (Mi Cotización) -->
    <template id="header_cart_link_inherit" inherit_id="website_sale.header_cart_link">
        <xpath expr="//a[contains(@href, '/shop/cart')]" position="replace">
            <a href="/shop/cart" t-attf-class="#{_link_class}" aria-label="eCommerce cart" t-att-title="'Mi Cotización' if website.quotation_only else 'My Cart'">
                <div t-attf-class="#{_icon_wrap_class}">
                    <i t-if="_icon" class="fa fa-shopping-cart fa-stack"/>
                    <sup t-attf-class="my_cart_quantity badge text-bg-primary #{_badge_class} #{'d-none' if (website_sale_cart_quantity == 0) else ''}" t-esc="website_sale_cart_quantity" t-att-data-order-id="request.session.get('sale_order_id', '')"/>
                </div>
                <span t-if="_text" t-attf-class="#{_text_class}">
                    <t t-if="website.quotation_only">Mi Cotización</t>
                    <t t-else="">My Cart</t>
                </span>
            </a>
        </xpath>
    </template>

    <!-- 2. Página de Producto: Reemplazar "Añadir al carrito" -->
    <template id="product_inherit" inherit_id="website_sale.product">
        <xpath expr="//a[@id='add_to_cart']" position="replace">
            <a role="button" id="add_to_cart" 
               t-attf-class="btn btn-primary btn-lg js_check_product a-submit flex-grow-1 #{'btn-secondary' if website.quotation_only else ''}" 
               href="#">
                <t t-if="website.quotation_only">Solicitar Cotización</t>
                <t t-else="">Add to Cart</t>
            </a>
        </xpath>
    </template>

    <!-- 2b. Botón Comprar Ahora (Opcional): Ocultar si está activo -->
    <template id="product_buy_now_inherit" inherit_id="website_sale.product_buy_now">
        <xpath expr="//a[hasclass('o_we_buy_now')]" position="attributes">
            <attribute name="t-attf-class">btn btn-outline-primary o_we_buy_now ms-1 #{'d-none' if website.quotation_only else ''}</attribute>
        </xpath>
    </template>

    <!-- 3. Elemento de Producto en Grid/Lista (Botón rápido de añadir al carrito) -->
    <template id="products_add_to_cart_inherit" inherit_id="website_sale.products_add_to_cart">
        <xpath expr="//a[hasclass('a-submit')]" position="attributes">
            <attribute name="t-att-title">'Añadir a Cotización' if website.quotation_only else 'Add to Cart'</attribute>
            <attribute name="aria-label">'Añadir a Cotización' if website.quotation_only else 'Add to Cart'</attribute>
        </xpath>
    </template>

    <!-- 4. Página de Carrito: Cambiar títulos -->
    <template id="cart_inherit" inherit_id="website_sale.cart">
        <xpath expr="//h3" position="replace">
            <h3 class="mb-4">
                <t t-if="website.quotation_only">Detalle de Cotización</t>
                <t t-else="">Order overview</t>
            </h3>
        </xpath>
    </template>

    <!-- 5. Botones de Navegación del Checkout: Proceder/Confirmar Cotización -->
    <template id="navigation_buttons_inherit" inherit_id="website_sale.navigation_buttons">
        <xpath expr="//a[@name='website_sale_main_button']" position="replace">
            <a role="button" name="website_sale_main_button"
                t-attf-class="#{_cta_classes} btn btn-primary #{not website_sale_order._is_cart_ready() and 'disabled'} #{_form_send_navigation and 'order-lg-3 w-100 w-lg-auto ms-lg-auto' or 'w-100'}"
                t-att-href="step_specific_values['main_button_href']">
                <t t-if="website.quotation_only">
                    <t t-if="xmlid == 'website_sale.cart'">Proceder con la Cotización</t>
                    <t t-elif="xmlid == 'website_sale.checkout'">Confirmar Cotización</t>
                    <t t-else=""><t t-out="step_specific_values['main_button']"/></t>
                </t>
                <t t-else="">
                    <t t-out="step_specific_values['main_button']"/>
                </t>
                <i class="fa fa-angle-right ms-2 fw-light"/>
            </a>
        </xpath>
    </template>

    <!-- 6. Página de Checkout (Vista Kanban de Selección de Direcciones) -->
    <template id="checkout_inherit" inherit_id="website_sale.checkout">
        <xpath expr="//h4[1]" position="replace">
            <h4>
                <t t-if="website.quotation_only">Datos del Solicitante</t>
                <t t-else="">Billing</t>
            </h4>
        </xpath>
    </template>

    <!-- 7. Formulario de Dirección (/shop/address) -->
    <template id="address_inherit" inherit_id="website_sale.address">
        <xpath expr="//t[contains(@t-elif, 'billing')]/h3" position="replace">
            <h3 class="mb-3">
                <t t-if="website.quotation_only">Dirección del Solicitante</t>
                <t t-else="">Billing address</t>
            </h3>
        </xpath>
        <xpath expr="//div[hasclass('alert-warning')]/p" position="replace">
            <p>
                <t t-if="website.quotation_only">
                    Está editando su dirección de <b>solicitante y envío</b> al mismo tiempo.<br/>
                     Si desea modificar su dirección de envío, cree una <a href='/shop/address'>nueva dirección</a>.
                </t>
                <t t-else="">
                    You are editing your <b>billing and shipping</b> addresses at the same time!<br/>
                    If you want to modify your shipping address, create a <a href='/shop/address'>new address</a>.
                </t>
            </p>
        </xpath>
    </template>

    <!-- 8. Página de Confirmación: Cambiar a Cotización Recibida y ocultar pagos -->
    <template id="confirmation_inherit" inherit_id="website_sale.confirmation">
        <!-- Título principal -->
        <xpath expr="//t[@t-set='tx_sudo']" position="before">
            <t t-if="website.quotation_only">
                <div class="d-flex justify-content-between align-items-center">
                    <h3>¡Gracias por su solicitud de cotización!</h3>
                </div>
            </t>
        </xpath>

        <!-- Bloque de pedido cuando la transacción es realizada/completada -->
        <xpath expr="//t[contains(@t-if, '==')]/div[hasclass('mb-4')]" position="replace">
            <div class="mb-4">
                <h5>
                    <em>
                        <t t-if="website.quotation_only">
                            <span>Cotización</span>
                            <span t-field="order.name" />
                            <i class="fa fa-check-circle ms-1"/>
                        </t>
                        <t t-else="">
                            <span>Order</span>
                            <span t-field="order.name" />
                            <t t-if="order.state == 'sale'">
                                <i class="fa fa-check-circle ms-1"/>
                            </t>
                        </t>
                    </em>
                </h5>
            </div>
        </xpath>

        <!-- Bloque de pedido cuando la transacción no es realizada/completada -->
        <xpath expr="//t[contains(@t-if, '!=')]/div[hasclass('mb-4')]" position="replace">
            <div class="mb-4">
                <h5>
                    <em>
                        <t t-if="website.quotation_only">
                            <span>Cotización</span>
                            <span t-field="order.name" />
                            <i class="fa fa-check-circle ms-1"/>
                        </t>
                        <t t-else="">
                            <span>Order</span>
                            <span t-field="order.name" />
                            <t t-if="order.state == 'sale'">
                                <i class="fa fa-check-circle ms-1"/>
                            </t>
                        </t>
                    </em>
                </h5>
            </div>
        </xpath>

        <!-- Ocultar detalles de pago -->
        <xpath expr="//h4" position="attributes">
            <attribute name="t-if">not website.quotation_only</attribute>
        </xpath>
        <xpath expr="//h4/following-sibling::table[1]" position="attributes">
            <attribute name="t-if">not website.quotation_only</attribute>
        </xpath>
        <xpath expr="//t[@t-call='website_sale.payment_confirmation_status']" position="attributes">
            <attribute name="t-if">not website.quotation_only</attribute>
        </xpath>

        <!-- Cuadro explicativo de Cotización -->
        <xpath expr="//div[@id='address_on_confirmation']" position="before">
            <t t-if="website.quotation_only">
                <div class="card mt-3 mb-4">
                    <div class="card-body">
                        <h3>Solicitud de Cotización <t t-esc="order.name"/></h3>
                        <p>Hemos registrado su solicitud de cotización en borrador. Le enviaremos un correo y/o un Whatsapp con el presupuesto formal.</p>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- 8. Dirección en Checkout/Confirmación (address_on_payment) -->
    <template id="address_on_payment_inherit" inherit_id="website_sale.address_on_payment">
        <xpath expr="//div[@id='shipping_and_billing']/div[1]/b" position="replace">
            <b>
                <t t-if="website.quotation_only">
                    Datos de dirección
                    <t t-if="same_shipping and not only_services" groups="account.group_delivery_invoice_address"> y Envío</t>:
                </t>
                <t t-else="">
                    Billing
                    <t t-if="same_shipping and not only_services" groups="account.group_delivery_invoice_address"> &amp; Shipping</t>:
                </t>
            </b>
        </xpath>
    </template>

    <!-- 9. Tienda (products_item): Ocultar precios para invitados si está en modo solo cotización -->
    <template id="products_item_inherit" inherit_id="website_sale.products_item">
        <xpath expr="//div[@itemprop='offers']" position="attributes">
            <attribute name="t-if">not (website.quotation_only and website.is_public_user())</attribute>
        </xpath>
    </template>

    <!-- 10. Detalle de Producto (product_price): Ocultar precios para invitados si está en modo solo cotización -->
    <template id="product_price_inherit" inherit_id="website_sale.product_price">
        <xpath expr="//div[@itemprop='offers']" position="attributes">
            <attribute name="t-if">not (website.quotation_only and website.is_public_user())</attribute>
        </xpath>
    </template>

    <!-- 11. Líneas del Carrito (cart_lines): Ocultar precios unitarios y subtotales de líneas para invitados -->
    <template id="cart_lines_inherit" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@name='website_sale_cart_line_price']" position="attributes">
            <attribute name="t-if">not (website.quotation_only and website.is_public_user())</attribute>
        </xpath>
    </template>

    <!-- 12. Totales del Carrito (total): Ocultar subtotal, impuestos y totales para invitados -->
    <template id="total_inherit" inherit_id="website_sale.total">
        <xpath expr="//div[@id='cart_total']" position="attributes">
            <attribute name="t-if">not (website.quotation_only and website.is_public_user())</attribute>
        </xpath>
    </template>

    <!-- 13. Inyectar CSS para ocultar precios en el modal de agregado al carrito para invitados -->
    <template id="layout_inherit" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <style t-if="website.quotation_only and website.is_public_user()">
                .toast.show .toast-body div.row div.col-3.d-flex.flex-column.align-items-end {
                    display: none !important;
                }
            </style>
        </xpath>
    </template>

</odoo>
