<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Herencia para el Reporte PDF impreso (priority 100000000 para ejecutarse DESPUÉS de Web Studio priority 9999999) -->
    <template id="report_saleorder_document_inherit_photo" inherit_id="sale.report_saleorder_document" priority="100000000">
        <!-- Encabezado columna Imagen en PDF -->
        <xpath expr="//table[hasclass('o_main_table')]//th[1]" position="before">
            <th t-if="doc.show_product_image" name="th_image" class="text-center" style="width: 60px;">Imagen</th>
        </xpath>

        <!-- Celda con imagen del producto en PDF -->
        <xpath expr="//table[hasclass('o_main_table')]//td[@name='td_name']" position="before">
            <td t-if="doc.show_product_image" name="td_image" class="text-center align-middle" style="width: 60px; padding: 4px;">
                <t t-if="line.product_id and line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)" style="max-height: 50px; max-width: 50px; object-fit: contain; border-radius: 4px;" alt="Foto Producto"/>
                </t>
            </td>
        </xpath>
    </template>

    <!-- 2. Herencia para la Vista Web / Portal / Preview del Pedido -->
    <template id="sale_order_portal_content_inherit_photo" inherit_id="sale.sale_order_portal_content" priority="100000000">
        <!-- Encabezado columna Imagen en Vista Portal -->
        <xpath expr="//table[@id='sales_order_table']/thead//th[@id='product_name_header']" position="before">
            <th t-if="sale_order.show_product_image" name="th_portal_image" class="text-center" style="width: 65px;">Imagen</th>
        </xpath>

        <!-- Celda con imagen del producto en Vista Portal -->
        <xpath expr="//table[@id='sales_order_table']/tbody//td[@id='product_name']" position="before">
            <td t-if="sale_order.show_product_image" name="td_portal_image" class="text-center align-middle" style="width: 65px; padding: 4px;">
                <t t-if="line.product_id and line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)" style="max-height: 50px; max-width: 50px; object-fit: contain; border-radius: 4px;" alt="Foto Producto"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
