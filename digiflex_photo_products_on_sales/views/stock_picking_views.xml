<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_photo" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.photo</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Agregar campo show_product_image cerca de la fecha programada / origen -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="show_product_image" widget="boolean_toggle"/>
            </xpath>

            <!-- Agregar columna de imagen en la lista de movimientos/operaciones -->
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="before">
                <field name="product_image" widget="image" options="{'size': [40, 40]}" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
